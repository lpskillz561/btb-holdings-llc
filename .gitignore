# ---- Dependencies ----
node_modules/
**/node_modules/

# ---- Next.js build output ----
.next/
**/.next/
out/
**/out/
*.tsbuildinfo
**/*.tsbuildinfo
next-env.d.ts
**/next-env.d.ts

# ---- Secrets / environment ----
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# ---- Databases & uploads (runtime data) ----
*.db
*.db-journal
**/*.db
**/*.db-journal
**/prisma/dev.db
**/uploads/
ziora-ai-business-overview/uploads/

# ---- Logs & OS ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
.DS_Store
**/.DS_Store

# ---- Client legal & tax documents ----
# The contracts, the tax memorandum and the pro forma in docs/ are client
# material, not source. They are the source of truth for how this app writes
# documents (see CLAUDE.md) but they do not belong in the repository, and the
# deploy tarball excludes docs/ for the same reason.
# Markdown in docs/ IS tracked — that is project documentation.
docs/*.pdf
docs/*.docx
docs/*.doc
docs/*.xlsx
docs/*.pptx
