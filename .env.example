# Copy to .env.local for development.

# PostgreSQL. The app creates its own tables on first request.
DATABASE_URL=postgres://user:pass@localhost:5432/btbcrm

# Signs session cookies. Generate with: openssl rand -hex 32
# MUST be identical as a Docker build arg and at runtime — the Edge middleware
# freezes it at build time, so a mismatch fails every session silently.
AUTH_SECRET=

# AI: proposal drafting, land-fit assessment, the client advisor.
# Without it those features are disabled with a notice, not an error.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Built-in accounts, comma-separated email:password pairs.
AUTH_USERS=info@ziora.io:ChangeMe123

# Invite code for /register. Blank closes self-registration.
REGISTRATION_CODE=

# Comma-separated emails allowed into the CRM.
# BLANK MEANS EVERY SIGNED-IN USER HAS ACCESS — this app holds client tax
# profiles, so set it once there is more than one kind of user.
CRM_ADMINS=

# The party named as Seller, Creditor and Agent on every generated contract.
# BTB Holdings stands in the role the sample documents in docs/ gave to MH
# Services LLC. Contract generation REFUSES until the address and wire block
# below are set — a purchase agreement carrying a placeholder account number is
# worse than no agreement. See src/lib/crm/parties.ts.
CRM_SELLER_LEGAL_NAME=BTB HOLDINGS LLC
CRM_SELLER_ADDRESS1=
CRM_SELLER_ADDRESS2=
CRM_SELLER_CITY=
CRM_SELLER_STATE=
CRM_SELLER_POSTAL=
CRM_SELLER_PHONE=
# Drives the governing-law and arbitration-venue clauses.
CRM_SELLER_STATE_OF_ORG=Nevada
CRM_SELLER_COUNTY=Clark County
CRM_SELLER_SIGNATORY=
CRM_SELLER_SIGNATORY_TITLE=Manager

# Where the buyer wires the deposit. Gets read out of a contract and typed into
# a bank by someone who will not double-check it.
CRM_WIRE_BANK_NAME=
CRM_WIRE_ACCOUNT_NAME=
CRM_WIRE_BANK_ADDRESS=
CRM_WIRE_ACCOUNT_NUMBER=
CRM_WIRE_ROUTING_NUMBER=

# Proposal assumptions. Every one is a figure a CPA will check, which is why
# they are configuration rather than constants. See src/lib/crm/economics.ts.
# CRM_BONUS_DEPRECIATION_RATE_BPS=10000
# CRM_DEFAULT_MARGINAL_RATE_BPS=3700
# CRM_DEFAULT_USEFUL_LIFE_YEARS=5
# 7000, not the 8500 this line used to show — an 85% default was never supported
# by anything, and the pro forma in docs/ is headed 70%. See CLAUDE.md.
# CRM_DEFAULT_OCCUPANCY_BPS=7000
# CRM_DEFAULT_OPEX_BPS=3500

# The AMUSEMENT-EQUIPMENT programme — the second product line. Commercial
# amusement equipment under §168(k), Asset Class 79.0, bought directly by the
# client's own trade or business. Nothing to do with the Park Models above
# beyond the statute; see SKILL.md §6 and src/lib/crm/equipment.ts.
#
# Unlike the tiny-home note, the rate and term here are genuinely variable —
# there is no memorandum of law built on a fixed shape, so a buyer financing
# through their own bank is a normal outcome rather than a different deal.
# CRM_EQUIPMENT_UNIT_PRICE_CENTS=15000000
# CRM_EQUIPMENT_DEPOSIT_BPS=1000
# CRM_EQUIPMENT_TERM_MONTHS=180
# CRM_EQUIPMENT_RATE_BPS=0
# CRM_EQUIPMENT_FLEET_UNITS=10

# Illustrative gross collections per unit per month, low and high case. These
# are HYPOTHETICAL and must never be presented as a projection.
# CRM_EQUIPMENT_GROSS_LOW_CENTS=500000
# CRM_EQUIPMENT_GROSS_HIGH_CENTS=1000000

# The revenue split, which is TWO-STAGE: the player payout comes off GROSS, and
# the venue and service shares come off WHAT REMAINS. Read flat against gross
# the owner's net comes out materially light.
# CRM_EQUIPMENT_PAYOUT_BPS=3000
# CRM_EQUIPMENT_VENUE_BPS=1500
# CRM_EQUIPMENT_SERVICE_BPS=3000
