[Unit]
Description=BTB zoning sync (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# The county service answers in 10-20 seconds per request however little is
# asked of it, so a batch of 5,000 parcels is roughly fifteen minutes. An hour
# is generous headroom, not an expectation.
TimeoutStartSec=3600
ExecStart=/opt/btb/run-etl.sh zoning %i
StandardOutput=journal
StandardError=journal
